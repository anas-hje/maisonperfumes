// Maison — data model.
// Mirrors the shapes in src/lib/types.ts so the app's existing domain types stay
// authoritative; see src/lib/mappers.ts for the row -> domain-type conversion.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 removed `url` from this block: the migrate/introspect connection string
// now lives in prisma.config.ts, and the runtime client connects via a driver
// adapter (see src/lib/server/db.ts).
datasource db {
  provider = "postgresql"
}

model Product {
  id           String   @id
  slug         String   @unique
  name         String
  brand        String
  description  String
  category     String
  subcategory  String
  gender       String
  images       String[]
  tags         String[]
  isFeatured   Boolean  @default(false)
  isOnSale     Boolean  @default(false)
  isNewArrival Boolean  @default(false)
  rating       Float    @default(0)
  reviewCount  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  variants   Variant[]
  orderItems OrderItem[]

  // Listing pages filter by category and sort by recency.
  @@index([category])
  @@index([createdAt])
}

model Variant {
  id             String  @id
  productId      String
  label          String
  price          Int // Centimes avoided: MAD prices in this catalogue are whole dirhams.
  compareAtPrice Int?
  stock          Int     @default(0)
  sku            String  @unique

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId])
}

model Order {
  id            String      @id @default(cuid())
  // Human-facing reference shown to the customer (ORD-XXXXXXXX).
  reference     String      @unique
  status        OrderStatus @default(PENDING)
  paymentMethod PaymentMethod
  subtotal      Int
  shippingCost  Int
  total         Int

  // Denormalised on purpose: a delivery address is a record of where this order was
  // actually sent, and must not change if the customer later edits their details.
  firstName  String
  lastName   String
  phone      String
  city       String
  address    String
  postalCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]

  // Admin lists orders newest-first and looks customers up by phone.
  @@index([createdAt])
  @@index([phone])
  @@index([status])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  variantId String
  quantity  Int
  // Captured at purchase time so later price changes don't rewrite order history.
  unitPrice Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Restrict: deleting a product that appears in an order would corrupt that order's
  // history, so the delete is refused rather than cascading.
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  CARD
}
